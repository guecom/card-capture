# Vendored OCR runtime hashes are release invariants; never rewrite line endings.
docs/vendor/tesseract/*.js binary
docs/vendor/tesseract/*.gz binary

# OCR vendor assets are hash-pinned - never EOL-convert them
docs/vendor/paddleocr/** -text
docs/vendor/ort/** -text
docs/vendor/tesseract/** -text
docs/vendor/cardquad/*.onnx -text
docs/vendor/cardquad/LICENSE text eol=lf
docs/vendor/cardquad/*.md text eol=lf

# 자체 호스팅 서체도 해시로 고정된 자산이다 (founder 2026-07-28).
# Windows 체크아웃(core.autocrlf=true)에서 EOL 변환이 한 번이라도 닿으면 파일이 깨지고
# validate.ps1의 pinned hash와 Pages blob 비교가 동시에 무너진다. 절대 텍스트로 다루지 않는다.
*.woff2 -text
